{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plus",
  "version": "0.1.0",
  "identifier": "com.plus.workspace.v1",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plus",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 23 },
        "backgroundColor": "#0d121c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/plus-node", "binaries/plus-codex", "binaries/codex-code-mode-host"],
    "resources": { "resources/server.cjs": "server.cjs", "../dist/": "web/" },
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
